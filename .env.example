# Copy to .env and fill in real values. Never commit .env.
# Public URL of the deployed site (no trailing slash). Used for canonical,
# Open Graph and Twitter share URLs.
VITE_SITE_URL=http://localhost:5173

# "Buy us a drink" tip page, e.g. https://buymeacoffee.com/your-handle or
# https://ko-fi.com/your-handle. Must start with https://. The header button
# is hidden while this is empty.
VITE_TIP_URL=
