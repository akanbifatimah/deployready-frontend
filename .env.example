# Copy to .env and fill in real values. Never commit .env.
# Public URL of the deployed site (no trailing slash). Used for canonical,
# Open Graph and Twitter share URLs.
VITE_SITE_URL=http://localhost:5173

# Tip page. Must start with https://. When empty, the button and footer
# link use https://buymeamalt.com/@pipsdeployready.
VITE_TIP_URL=https://buymeamalt.com/@pipsdeployready
